# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# Used by the "invalid login" negative scenarios (SauceDemo does not accept
# an email as a username, so this is a great fixture for negative testing).
TEST_USER_EMAIL=test.user@example.com
TEST_USER_PASSWORD=changeme123

# Used by ApiClient for HTTP Basic Auth demo tests against httpbin.org.
API_AUTH_USERNAME=api-user
API_AUTH_PASSWORD=changeme123

# Application under test.
SAUCEDEMO_BASE_URL=https://www.saucedemo.com/

# Optional overrides (also settable as -D system properties or CLI -D flags).
BROWSER=chrome
HEADLESS=false
